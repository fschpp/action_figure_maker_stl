{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fschpp/action_figure_maker_stl/schemas/afm-paquete-1.schema.json",
  "title": "afm-paquete-1",
  "description": "Manifiesto paquete.json de un paquete de catálogo (plan de catálogos en línea, §5.2). Evolución aditiva: se permiten claves que este esquema no conoce; solo un «formato» de otra versión mayor rompe la lectura.",
  "type": "object",
  "required": [
    "formato",
    "id",
    "nombre",
    "version",
    "descripcion",
    "tipo",
    "autores",
    "licencia",
    "origen"
  ],
  "properties": {
    "formato": {
      "const": "afm-paquete-1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "nombre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "descripcion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "tipo": {
      "enum": [
        "linea",
        "piezas",
        "heroe",
        "coleccion"
      ]
    },
    "autores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "nombre"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "github": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
          }
        }
      }
    },
    "licencia": {
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "CC-BY-SA-4.0",
        "CC-BY-ND-4.0",
        "CC-BY-NC-4.0",
        "CC-BY-NC-SA-4.0",
        "CC-BY-NC-ND-4.0",
        "CC-BY-3.0",
        "CC-BY-SA-3.0",
        "CC-BY-NC-3.0",
        "CC-BY-NC-SA-3.0",
        "MIT",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "Unlicense",
        "GPL-3.0-only",
        "GPL-3.0-or-later",
        "LGPL-3.0-only",
        "LGPL-3.0-or-later",
        "todos-los-derechos-reservados"
      ]
    },
    "origen": {
      "enum": [
        "propia",
        "derivada",
        "dominio-publico",
        "con-permiso",
        "referencia"
      ]
    },
    "github": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "linea": {
      "type": "object",
      "required": [
        "nombre",
        "altura_mm"
      ],
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1
        },
        "altura_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "motor": {
      "type": "string",
      "minLength": 1,
      "description": "Rango de versiones del motor (>=0.2.1, ^0.2.0, >=0.2.1,<0.4.0…)."
    },
    "contenido": {
      "type": "object",
      "properties": {
        "piezas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*@[1-9]\\d*$"
          }
        },
        "recetas": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "paleta": {
          "type": "boolean"
        },
        "pines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "github",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "github": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "requiere": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "experimental": {
      "type": "boolean"
    },
    "categorias": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "heroes",
          "cuerpos",
          "cabezas",
          "manos",
          "armas-accesorios",
          "ropa",
          "paletas",
          "lineas",
          "colecciones",
          "otros"
        ]
      }
    },
    "etiquetas": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "archivos": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "referencias_requeridas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "sha256",
          "tamano_max"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "tamano_max": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "coleccion"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "required": [
          "contenido"
        ],
        "properties": {
          "contenido": {
            "required": [
              "pines"
            ],
            "properties": {
              "pines": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "linea"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "origen": {
            "const": "referencia"
          }
        },
        "required": [
          "origen"
        ]
      },
      "then": {
        "required": [
          "referencias_requeridas"
        ],
        "properties": {
          "referencias_requeridas": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
